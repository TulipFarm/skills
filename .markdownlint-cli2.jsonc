{
  // Lint the human-facing docs only. Skill bodies (skills/**/SKILL.md) are a
  // controlled hand-authored format — their structure is enforced by AGENTS.md
  // and scripts/validate-marketplace.mjs, and they deliberately use bare fenced
  // template blocks (MD040) that a generic prose linter would fight.
  "config": {
    "default": true,
    "MD013": false, // line length — prose wraps naturally, don't enforce a column
    "MD033": false, // inline HTML — allowed if a doc needs it
    "MD041": false  // first line need not be a heading
  },
  "globs": ["README.md", "AGENTS.md"],
  "ignores": ["node_modules", ".git"]
}
